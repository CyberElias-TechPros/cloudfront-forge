{
  "name": "creatorloop-api",
  "version": "1.0.0",
  "description": "CreatorLoop API - Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate": "wrangler d1 migrations apply creatorloop-db --remote",
    "db:migrate:staging": "wrangler d1 migrations apply creatorloop-db-staging --env staging --remote",
    "db:migrate:local": "wrangler d1 migrations apply creatorloop-db --local",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2024001",
    "@eslint/js": "^9.32.0",
    "@types/node": "^26.2.0",
    "node-sqlite3-wasm": "^0.8.60",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
