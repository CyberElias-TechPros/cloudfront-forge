# Worker environment — copy to `.dev.vars` for `wrangler dev`.
#
# Non-secret configuration (CORS origins, reward amounts, rate limits) already
# lives in wrangler.toml [vars]. Everything below is a SECRET and must be set
# with `wrangler secret put NAME` (or `--env staging`) — never committed.
#
#   cp .env.example .dev.vars   # then fill in real values
#   npm run dev

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Verifies Firebase ID tokens. Must equal the frontend's VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Signs the short-lived watch-session tokens used by server-side playback
# verification. Generate with: openssl rand -hex 32
# MANDATORY when ENVIRONMENT=production — the Worker refuses to fall back to a
# development key there.
WATCH_SESSION_SECRET=

# ---------------------------------------------------------------------------
# AI assistant (OpenAI-compatible chat completions)
# ---------------------------------------------------------------------------
# PROVIDER selects the endpoint: nvidia → integrate.api.nvidia.com,
# google → generativelanguage.googleapis.com (OpenAI compatibility layer).
# AI_MODEL must be a model id that provider actually serves, e.g.
#   nvidia → meta/llama-3.1-8b-instruct
#   google → gemini-2.0-flash
AI_PROVIDER=nvidia
AI_MODEL=meta/llama-3.1-8b-instruct
AI_API_KEY=

# Daily quota per member and across the whole deployment. Enforced BEFORE the
# conversation row is created, so a rejected message leaves no trace.
AI_DAILY_USER_LIMIT=30
AI_DAILY_GLOBAL_LIMIT=2000

# ---------------------------------------------------------------------------
# YouTube
# ---------------------------------------------------------------------------
# Optional server-side metadata lookup (title, thumbnail, duration). The
# submitter flow degrades gracefully without it.
YOUTUBE_API_KEY=
# Optional real subscription/comment verification via OAuth.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Web Push (RFC 8291)
# ---------------------------------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
# The public key must also be set on the frontend (VITE_VAPID_PUBLIC_KEY).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Weekly digest. Without a key the digest job logs and skips instead of failing.
RESEND_API_KEY=
