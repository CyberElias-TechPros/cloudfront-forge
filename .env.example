# Frontend environment — copy to `.env.local` and fill in.
#
# Everything in this file is PUBLIC: Vite inlines `VITE_*` into the browser
# bundle, so never put a secret here. Private keys belong in Cloudflare
# (`wrangler secret put`) or `workers/api/.dev.vars`.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Leave EMPTY in development: `npm run dev` proxies /api/* and /health to the
# Worker on http://localhost:8787, so the browser calls same-origin /api/*.
# In production this is REQUIRED — e.g. https://creatorloop-api.example.workers.dev
# There is no localhost fallback.
VITE_API_URL=

# ---------------------------------------------------------------------------
# Firebase (Google Sign-In)
# ---------------------------------------------------------------------------
# Public web config. Must match the Worker's FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Web Push
# ---------------------------------------------------------------------------
# Must be the public half of the Worker's VAPID keypair.
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Enables sitemap.xml + robots.xml during the build.
SITE_URL=
# Ad slot rendered by src/components/ad-slot.tsx when set.
VITE_ADSENSE_SLOT_ID=
# Local-only escape hatch: accept a fake "Dev User" session instead of Google
# Sign-In. Ignored in production builds.
VITE_USE_DEV_AUTH=
VITE_DEV_UID=
VITE_DEV_NAME=
